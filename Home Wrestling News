<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>HW - Home Wrestling Network</title>
  
  <!-- iOS PWA Meta Tags -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="HW Wrestling">
  <meta name="theme-color" content="#090d16">
  
  <!-- Apple Touch Icons & Fonts -->
  <link rel="apple-touch-icon" href="https://img.icons8.com/emoji/192/trophy-emoji.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Teko', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            hw: {
              gold: '#FFD700',
              goldLight: '#FFF099',
              red: '#E53E3E',
              darkRed: '#9B1C1C',
              card: '#131926',
              bg: '#090d16',
              border: '#232d42'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom iOS Native Scrollbars & Feel */
    body {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Gold Gradient Glow */
    .gold-glow {
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.25);
    }
    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF099 0%, #FFD700 50%, #B8860B 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .gold-gradient-bg {
      background: linear-gradient(135deg, #FFD700 0%, #D4AF37 100%);
    }
    .red-gradient-bg {
      background: linear-gradient(135deg, #E53E3E 0%, #9B1C1C 100%);
    }

    /* iOS safe areas */
    .pb-safe {
      padding-bottom: env(safe-area-inset-bottom, 1rem);
    }
    .pt-safe {
      padding-top: env(safe-area-inset-top, 0.5rem);
    }
  </style>
</head>
<body class="h-full bg-hw-bg text-slate-100 flex flex-col justify-between overflow-hidden">

  <!-- TOP APP HEADER -->
  <header class="pt-safe bg-hw-bg/90 backdrop-blur-md border-b border-hw-border sticky top-0 z-30 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <div class="w-10 h-10 rounded-xl gold-gradient-bg flex items-center justify-center font-display text-2xl font-black text-slate-950 shadow-md transform -rotate-3">
        HW
      </div>
      <div>
        <h1 class="font-display text-2xl tracking-wider leading-none text-white uppercase font-bold">
          Home <span class="gold-gradient-text">Wrestling</span>
        </h1>
        <p class="text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Official League App</p>
      </div>
    </div>

    <div class="flex items-center space-x-2">
      <button onclick="toggleAudio()" id="audioBtn" class="w-9 h-9 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-slate-300 active:scale-95 transition">
        <i class="fa-solid fa-volume-high text-sm" id="audioIcon"></i>
      </button>
      <button onclick="showPWAInstallPrompt()" class="w-9 h-9 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-hw-gold active:scale-95 transition">
        <i class="fa-solid fa-mobile-screen-button text-sm"></i>
      </button>
    </div>
  </header>

  <!-- MAIN SCROLLABLE CONTENT AREA -->
  <main id="appContainer" class="flex-1 overflow-y-auto no-scrollbar px-4 py-4 space-y-5 pb-28">

    <!-- iOS Home Screen Banner -->
    <div id="pwaBanner" class="bg-gradient-to-r from-slate-900 to-hw-card border border-hw-gold/40 rounded-2xl p-3.5 relative flex items-center justify-between shadow-lg">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-hw-gold/10 border border-hw-gold/30 flex items-center justify-center text-hw-gold text-lg">
          <i class="fa-solid fa-square-plus"></i>
        </div>
        <div class="text-xs">
          <p class="font-bold text-white">Add HW App to iPhone Home Screen!</p>
          <p class="text-slate-400 text-[11px]">Tap <i class="fa-solid fa-share-from-square text-blue-400"></i> then 'Add to Home Screen'</p>
        </div>
      </div>
      <button onclick="closePwaBanner()" class="text-slate-500 hover:text-slate-300 p-1">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- TAB 1: HOME FEED -->
    <section id="tab-home" class="tab-content space-y-5">
      
      <!-- Search & Quick Filters -->
      <div class="space-y-3">
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
          <input type="text" id="searchInput" oninput="renderArticles()" placeholder="Search articles, matches, wrestlers..." 
                 class="w-full bg-hw-card border border-hw-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-hw-gold transition">
        </div>

        <!-- Filter Pills -->
        <div class="flex space-x-2 overflow-x-auto no-scrollbar py-1">
          <button onclick="setFilter('All')" class="filter-btn active-filter px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-hw-gold text-slate-950 shadow-md">All News</button>
          <button onclick="setFilter('Match Recap')" class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-hw-card border border-hw-border text-slate-300">⚡ Recaps</button>
          <button onclick="setFilter('Title Bout')" class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-hw-card border border-hw-border text-slate-300">🏆 Title Bouts</button>
          <button onclick="setFilter('Power Rankings')" class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-hw-card border border-hw-border text-slate-300">📊 Rankings</button>
          <button onclick="setFilter('Fighter Spotlight')" class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-hw-card border border-hw-border text-slate-300">🔥 Spotlight</button>
        </div>
      </div>

      <!-- Featured Story Carousel/Hero -->
      <div id="featuredStoryContainer"></div>

      <!-- Latest Articles List Header -->
      <div class="flex items-center justify-between pt-2">
        <h2 class="font-display text-2xl tracking-wider uppercase text-white flex items-center space-x-2">
          <span>Recent Articles</span>
          <span class="w-2 h-2 rounded-full bg-hw-red inline-block animate-pulse"></span>
        </h2>
        <span id="articleCountBadge" class="text-xs bg-hw-card border border-hw-border px-2.5 py-1 rounded-full text-slate-400 font-mono">0 Posts</span>
      </div>

      <!-- Article Stream -->
      <div id="articlesList" class="space-y-4"></div>
    </section>

    <!-- TAB 2: ROSTER & BELTS -->
    <section id="tab-roster" class="tab-content hidden space-y-6">
      <!-- Title Belts Showcase -->
      <div>
        <h2 class="font-display text-2xl tracking-wider uppercase text-white mb-3 flex items-center">
          <i class="fa-solid fa-trophy text-hw-gold mr-2 text-xl"></i> Championship Belts
        </h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-hw-card border border-hw-gold/40 rounded-2xl p-4 text-center relative overflow-hidden group">
            <div class="absolute -right-4 -bottom-4 text-hw-gold/10 text-7xl font-black">HW</div>
            <div class="text-3xl mb-1">👑</div>
            <div class="text-xs font-bold text-hw-gold uppercase tracking-wider">HW World Heavyweight</div>
            <div class="font-display text-xl text-white mt-1">The Iron Comet</div>
            <span class="text-[10px] bg-hw-gold/20 text-hw-gold border border-hw-gold/30 px-2 py-0.5 rounded-full inline-block mt-2">Current Champion</span>
          </div>
          <div class="bg-hw-card border border-hw-border rounded-2xl p-4 text-center relative overflow-hidden">
            <div class="text-3xl mb-1">🥇</div>
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">HW Tag Team Belts</div>
            <div class="font-display text-xl text-white mt-1">Thunder & Lightning</div>
            <span class="text-[10px] bg-slate-800 text-slate-300 border border-slate-700 px-2 py-0.5 rounded-full inline-block mt-2">Defended 4x</span>
          </div>
        </div>
      </div>

      <!-- Wrestler Roster Grid -->
      <div>
        <h2 class="font-display text-2xl tracking-wider uppercase text-white mb-3 flex items-center">
          <i class="fa-solid fa-user-ninja text-hw-red mr-2 text-xl"></i> HW Roster & Power Ratings
        </h2>
        <div id="rosterList" class="space-y-3"></div>
      </div>
    </section>

    <!-- TAB 3: PUBLISH NEW ARTICLE -->
    <section id="tab-publish" class="tab-content hidden space-y-4">
      <div class="bg-hw-card border border-hw-border rounded-2xl p-4 space-y-4 shadow-xl">
        <div class="border-b border-hw-border pb-3">
          <h2 class="font-display text-3xl tracking-wider uppercase text-hw-gold">Publish HW News Article</h2>
          <p class="text-xs text-slate-400">Write match recaps, league updates, or roster announcements.</p>
        </div>

        <form id="publishForm" onsubmit="handlePublish(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Article Title *</label>
            <input type="text" id="pubTitle" required placeholder="e.g., Extreme Rules Ladder Match Recap!" 
                   class="w-full bg-slate-900 border border-hw-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-hw-gold transition">
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Category *</label>
              <select id="pubCategory" required class="w-full bg-slate-900 border border-hw-border rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-hw-gold">
                <option value="Match Recap">⚡ Match Recap</option>
                <option value="Title Bout">🏆 Title Bout</option>
                <option value="Power Rankings">📊 Power Rankings</option>
                <option value="Fighter Spotlight">🔥 Fighter Spotlight</option>
                <option value="League News">📢 League News</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Featured Wrestler</label>
              <input type="text" id="pubWrestler" placeholder="e.g. Iron Comet" 
                     class="w-full bg-slate-900 border border-hw-border rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-hw-gold">
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Subtitle / Quick Summary</label>
            <input type="text" id="pubSubtitle" placeholder="Brief headline hook for the story..." 
                   class="w-full bg-slate-900 border border-hw-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-hw-gold">
          </div>

          <!-- Banner Image or Emoji selector -->
          <div>
            <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Cover Image Header</label>
            <div class="grid grid-cols-2 gap-2 mb-2">
              <button type="button" onclick="setPresetImg('wrestling-ring')" class="bg-slate-900 border border-hw-border p-2 rounded-xl text-xs text-slate-300 hover:border-hw-gold">🤼 Ring Action</button>
              <button type="button" onclick="setPresetImg('trophy')" class="bg-slate-900 border border-hw-border p-2 rounded-xl text-xs text-slate-300 hover:border-hw-gold">🏆 Championship Belt</button>
              <button type="button" onclick="setPresetImg('stadium')" class="bg-slate-900 border border-hw-border p-2 rounded-xl text-xs text-slate-300 hover:border-hw-gold">🏟️ Arena Crowd</button>
              <button type="button" onclick="setPresetImg('fire')" class="bg-slate-900 border border-hw-border p-2 rounded-xl text-xs text-slate-300 hover:border-hw-gold">🔥 Rivalry</button>
            </div>
            <input type="url" id="pubImage" placeholder="Or paste custom image URL" 
                   class="w-full bg-slate-900 border border-hw-border rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-hw-gold">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Full Article Content *</label>
            <textarea id="pubContent" required rows="6" placeholder="Write full article details, moves, match results, pinfalls, or quotes..." 
                      class="w-full bg-slate-900 border border-hw-border rounded-xl p-3 text-sm text-white focus:outline-none focus:border-hw-gold"></textarea>
          </div>

          <button type="submit" class="w-full gold-gradient-bg text-slate-950 font-bold py-3.5 rounded-xl font-display text-xl tracking-wider uppercase shadow-lg active:scale-[0.98] transition">
            <i class="fa-solid fa-paper-plane mr-2"></i> Publish Article to HW App
          </button>
        </form>
      </div>
    </section>

    <!-- TAB 4: SAVED & BOOKMARKS -->
    <section id="tab-saved" class="tab-content hidden space-y-4">
      <h2 class="font-display text-2xl tracking-wider uppercase text-white flex items-center">
        <i class="fa-solid fa-bookmark text-hw-gold mr-2"></i> Bookmarked HW Articles
      </h2>
      <div id="savedList" class="space-y-3"></div>
    </section>

  </main>

  <!-- ARTICLE DETAIL / READER MODAL -->
  <div id="articleModal" class="fixed inset-0 bg-slate-950/95 backdrop-blur-xl z-50 hidden flex-col overflow-hidden transition-all duration-300">
    <!-- Top Modal Bar -->
    <div class="pt-safe bg-hw-bg border-b border-hw-border px-4 py-3 flex items-center justify-between">
      <button onclick="closeArticleModal()" class="w-9 h-9 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-slate-300 active:scale-95">
        <i class="fa-solid fa-chevron-left text-sm"></i>
      </button>
      
      <div class="flex items-center space-x-3">
        <!-- Text Size Toggle -->
        <button onclick="toggleFontSize()" class="w-8 h-8 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-xs font-bold text-slate-300">
          A<span class="text-[10px]">A</span>
        </button>
        <!-- Bookmark Button -->
        <button id="modalBookmarkBtn" onclick="toggleBookmarkCurrent()" class="w-9 h-9 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-slate-300 active:scale-95">
          <i class="fa-regular fa-bookmark"></i>
        </button>
        <!-- Share -->
        <button onclick="simulateShare()" class="w-9 h-9 rounded-full bg-hw-card border border-hw-border flex items-center justify-center text-slate-300 active:scale-95">
          <i class="fa-solid fa-share-nodes"></i>
        </button>
      </div>
    </div>

    <!-- Article Content View -->
    <div id="modalBody" class="flex-1 overflow-y-auto p-4 space-y-4 pb-20 no-scrollbar"></div>

    <!-- Modal Sticky Bottom Bar -->
    <div class="p-4 bg-hw-card/90 border-t border-hw-border backdrop-blur-md flex items-center justify-between">
      <button id="modalLikeBtn" onclick="likeCurrentArticle()" class="flex items-center space-x-2 bg-hw-red/20 border border-hw-red/40 text-hw-red px-4 py-2 rounded-xl text-sm font-bold active:scale-95 transition">
        <i class="fa-solid fa-heart"></i>
        <span id="modalLikeCount">0</span>
      </button>
      <span class="text-xs text-slate-400 font-mono">HW Official Article</span>
    </div>
  </div>

  <!-- BOTTOM IOS DOCK NAVIGATION -->
  <nav class="fixed bottom-0 left-0 right-0 bg-hw-bg/95 border-t border-hw-border backdrop-blur-md z-40 pb-safe">
    <div class="grid grid-cols-4 h-16">
      <button onclick="switchTab('home')" id="nav-home" class="nav-btn flex flex-col items-center justify-center text-hw-gold transition">
        <i class="fa-solid fa-newspaper text-lg mb-1"></i>
        <span class="text-[10px] font-bold uppercase tracking-wider">Feed</span>
      </button>

      <button onclick="switchTab('roster')" id="nav-roster" class="nav-btn flex flex-col items-center justify-center text-slate-500 transition">
        <i class="fa-solid fa-shield-halved text-lg mb-1"></i>
        <span class="text-[10px] font-bold uppercase tracking-wider">Roster</span>
      </button>

      <button onclick="switchTab('publish')" id="nav-publish" class="nav-btn flex flex-col items-center justify-center text-slate-500 transition">
        <div class="w-9 h-9 rounded-full gold-gradient-bg text-slate-950 flex items-center justify-center shadow-lg -mt-3 border-2 border-hw-bg transform active:scale-95 transition">
          <i class="fa-solid fa-plus text-base font-black"></i>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-wider mt-0.5">Publish</span>
      </button>

      <button onclick="switchTab('saved')" id="nav-saved" class="nav-btn flex flex-col items-center justify-center text-slate-500 transition">
        <i class="fa-solid fa-bookmark text-lg mb-1"></i>
        <span class="text-[10px] font-bold uppercase tracking-wider">Saved</span>
      </button>
    </div>
  </nav>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed top-16 left-1/2 transform -translate-x-1/2 bg-hw-gold text-slate-950 font-bold px-4 py-2 rounded-full shadow-2xl text-xs z-50 opacity-0 pointer-events-none transition-all duration-300">
    Notification text
  </div>

  <script>
    // INITIAL SAMPLE DATA FOR HW (Home Wrestling)
    const SAMPLE_ARTICLES = [
      {
        id: "hw-1",
        title: "HW Tag Team Championship Shocker: Thunderbolt Pinfall!",
        subtitle: "The Blitz Twins stun the reigning champs in a thrilling 15-minute living room bout.",
        category: "Match Recap",
        wrestler: "Blitz Twins",
        image: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80",
        content: `In an absolute masterpiece of home wrestling, the Blitz Twins defeated The Chaos Duo to capture the HW Tag Team Belts! \n\nThe match featured a dramatic leap off the sofa cushion, followed by a double dropkick that turned the tide of battle. Fans in attendance (Mom and the family dog) were left stunned as Thunderbolt secured the 3-count.\n\n"We've been practicing that finisher for weeks on the carpet," said Thunderbolt after the match. A rematch has already been demanded for next weekend!`,
        date: "2 Hours Ago",
        likes: 14,
        isFeatured: true
      },
      {
        id: "hw-2",
        title: "Wrestler Profile: The Iron Comet's Road to Undisputed Champion",
        subtitle: "How determination, heavy mats, and lethal elbow drops created an HW legend.",
        category: "Fighter Spotlight",
        wrestler: "The Iron Comet",
        image: "https://images.unsplash.com/photo-1517649763962-0c623266ddc0?auto=format&fit=crop&w=800&q=80",
        content: `Standing tall at the top of the HW Power Rankings, The Iron Comet remains undefeated this season.\n\nKnown for his signature finisher 'The Comet Collision', he has successfully turned his bedroom training camp into championship gold. Opponents fear his swift leg sweeps and unmatched agility on the foam padding arena.\n\nWho will step up next to challenge the champion?`,
        date: "1 Day Ago",
        likes: 22,
        isFeatured: false
      },
      {
        id: "hw-3",
        title: "HW Season 3 Official Power Rankings & Title Predictions",
        subtitle: "Who dominates the ladder match standings as we head into the Summer Slam down the hallway?",
        category: "Power Rankings",
        wrestler: "League Wide",
        image: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=800&q=80",
        content: `Here are the official HW League Power Rankings heading into Week 6:\n\n1. The Iron Comet (Heavyweight Champion)\n2. Thunder Voltage (No. 1 Contender)\n3. Shadow Viper (Submission Specialist)\n4. The Blitz Twins (Tag Champs)\n\nExpect major shakeups as the hardcore championship rule allows title challenges anywhere inside the house!`,
        date: "3 Days Ago",
        likes: 9,
        isFeatured: false
      }
    ];

    const ROSTER_DATA = [
      { name: "The Iron Comet", title: "HW World Champ", record: "12-0", style: "High Flyer", rating: 98, emoji: "☄️" },
      { name: "Thunder Voltage", title: "No. 1 Contender", record: "9-2", style: "Powerhouse", rating: 94, emoji: "⚡" },
      { name: "The Blitz Twins", title: "Tag Champions", record: "8-1", style: "Tag Specialists", rating: 92, emoji: "👯" },
      { name: "Shadow Viper", title: "Hardcore Champion", record: "7-3", style: "Submission", rating: 89, emoji: "🐍" }
    ];

    // STATE MANAGEMENT
    let articles = [];
    let savedIds = JSON.parse(localStorage.getItem('hw_saved_articles') || '[]');
    let currentFilter = 'All';
    let activeArticle = null;
    let audioEnabled = true;
    let fontSizeLarge = false;

    // AUDIO SIMULATION
    function playSound(type) {
      if(!audioEnabled) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        if(type === 'click') {
          osc.frequency.setValueAtTime(400, ctx.currentTime);
          gain.gain.setValueAtTime(0.05, ctx.currentTime);
          osc.start();
          osc.stop(ctx.currentTime + 0.05);
        } else if(type === 'publish') {
          osc.frequency.setValueAtTime(300, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.2);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          osc.start();
          osc.stop(ctx.currentTime + 0.2);
        }
      } catch(e) {}
    }

    function toggleAudio() {
      audioEnabled = !audioEnabled;
      const icon = document.getElementById('audioIcon');
      icon.className = audioEnabled ? "fa-solid fa-volume-high text-sm" : "fa-solid fa-volume-xmark text-sm text-slate-500";
      showToast(audioEnabled ? "Sound Effects ON" : "Sound Effects Muted");
    }

    // INIT METHOD
    window.onload = function() {
      loadArticles();
      renderRoster();
      renderArticles();
    };

    function loadArticles() {
      const stored = localStorage.getItem('hw_articles');
      if(stored) {
        articles = JSON.parse(stored);
      } else {
        articles = SAMPLE_ARTICLES;
        localStorage.setItem('hw_articles', JSON.stringify(articles));
      }
    }

    // TAB NAVIGATION
    function switchTab(tabName) {
      playSound('click');
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(`tab-${tabName}`).classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('text-hw-gold');
        btn.classList.add('text-slate-500');
      });

      const activeNav = document.getElementById(`nav-${tabName}`);
      if(activeNav) {
        activeNav.classList.remove('text-slate-500');
        activeNav.classList.add('text-hw-gold');
      }

      if(tabName === 'saved') renderSavedArticles();
    }

    // RENDER HOME ARTICLES
    function renderArticles() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const listContainer = document.getElementById('articlesList');
      const heroContainer = document.getElementById('featuredStoryContainer');

      let filtered = articles.filter(art => {
        const matchesFilter = currentFilter === 'All' || art.category === currentFilter;
        const matchesSearch = art.title.toLowerCase().includes(search) || 
                              art.content.toLowerCase().includes(search) ||
                              art.wrestler.toLowerCase().includes(search);
        return matchesFilter && matchesSearch;
      });

      document.getElementById('articleCountBadge').innerText = `${filtered.length} Posts`;

      // Render Hero/Featured Story if on 'All' and no search
      if(currentFilter === 'All' && !search && filtered.length > 0) {
        const feat = filtered[0];
        heroContainer.innerHTML = `
          <div onclick="openArticleModal('${feat.id}')" class="relative rounded-2xl overflow-hidden bg-hw-card border border-hw-gold/40 shadow-2xl active:scale-[0.99] transition cursor-pointer group">
            <img src="${feat.image}" class="w-full h-52 object-cover group-hover:scale-105 transition duration-500" alt="Cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent flex flex-col justify-end p-4">
              <div class="flex items-center space-x-2 mb-1">
                <span class="bg-hw-gold text-slate-950 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full">FEATURED STORY</span>
                <span class="text-xs text-slate-300 font-mono">${feat.date}</span>
              </div>
              <h2 class="font-display text-2xl leading-tight text-white uppercase tracking-wide font-bold">${feat.title}</h2>
              <p class="text-xs text-slate-300 line-clamp-2 mt-1">${feat.subtitle}</p>
            </div>
          </div>
        `;
      } else {
        heroContainer.innerHTML = '';
      }

      // Render list items
      const displayList = (currentFilter === 'All' && !search && filtered.length > 0) ? filtered.slice(1) : filtered;

      if(displayList.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-10 bg-hw-card border border-hw-border rounded-2xl">
            <i class="fa-solid fa-newspaper text-3xl text-slate-600 mb-2"></i>
            <p class="text-slate-400 font-medium text-sm">No articles found.</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = displayList.map(art => `
        <div onclick="openArticleModal('${art.id}')" class="bg-hw-card border border-hw-border rounded-2xl p-3.5 flex space-x-3.5 items-center active:scale-[0.98] transition cursor-pointer">
          <img src="${art.image}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0" alt="Thumb" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between text-[11px] mb-1">
              <span class="text-hw-gold font-bold uppercase tracking-wider">${art.category}</span>
              <span class="text-slate-400 font-mono text-[10px]">${art.date}</span>
            </div>
            <h3 class="font-bold text-sm text-white truncate leading-snug">${art.title}</h3>
            <p class="text-xs text-slate-400 line-clamp-2 mt-0.5">${art.subtitle || art.content}</p>
            <div class="flex items-center justify-between mt-2 text-[11px] text-slate-400">
              <span class="text-hw-red font-semibold">🥊 ${art.wrestler}</span>
              <span class="flex items-center space-x-1"><i class="fa-solid fa-heart text-hw-red text-[10px]"></i> <span>${art.likes}</span></span>
            </div>
          </div>
        </div>
      `).join('');
    }

    // FILTER BUTTONS
    function setFilter(cat) {
      playSound('click');
      currentFilter = cat;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-hw-gold', 'text-slate-950', 'shadow-md');
        btn.classList.add('bg-hw-card', 'text-slate-300', 'border', 'border-hw-border');
      });
      event.target.classList.remove('bg-hw-card', 'text-slate-300', 'border-hw-border');
      event.target.classList.add('bg-hw-gold', 'text-slate-950', 'shadow-md');
      renderArticles();
    }

    // ROSTER TAB
    function renderRoster() {
      const container = document.getElementById('rosterList');
      container.innerHTML = ROSTER_DATA.map(w => `
        <div class="bg-hw-card border border-hw-border rounded-2xl p-3.5 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 rounded-xl bg-slate-900 border border-hw-border flex items-center justify-center text-2xl">
              ${w.emoji}
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="font-display text-xl text-white font-bold leading-none">${w.name}</h3>
                <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">${w.style}</span>
              </div>
              <p class="text-xs text-hw-gold font-semibold mt-0.5">${w.title}</p>
              <p class="text-[11px] text-slate-400 font-mono">Record: ${w.record}</p>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[10px] text-slate-500 font-bold uppercase">Overall</div>
            <div class="font-display text-2xl font-black text-hw-gold">${w.rating}</div>
          </div>
        </div>
      `).join('');
    }

    // PUBLISH NEW ARTICLE
    function handlePublish(e) {
      e.preventDefault();
      playSound('publish');

      const title = document.getElementById('pubTitle').value;
      const category = document.getElementById('pubCategory').value;
      const wrestler = document.getElementById('pubWrestler').value || 'HW League';
      const subtitle = document.getElementById('pubSubtitle').value;
      let image = document.getElementById('pubImage').value;
      const content = document.getElementById('pubContent').value;

      if(!image) {
        image = "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80";
      }

      const newArt = {
        id: "hw-" + Date.now(),
        title,
        subtitle,
        category,
        wrestler,
        image,
        content,
        date: "Just Now",
        likes: 1,
        isFeatured: false
      };

      articles.unshift(newArt);
      localStorage.setItem('hw_articles', JSON.stringify(articles));

      // Reset form & Switch to Feed
      document.getElementById('publishForm').reset();
      showToast("Article Published Successfully! 🎉");
      switchTab('home');
      renderArticles();
    }

    function setPresetImg(type) {
      const input = document.getElementById('pubImage');
      if(type === 'wrestling-ring') input.value = "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80";
      if(type === 'trophy') input.value = "https://images.unsplash.com/photo-1517649763962-0c623266ddc0?auto=format&fit=crop&w=800&q=80";
      if(type === 'stadium') input.value = "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=800&q=80";
      if(type === 'fire') input.value = "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=800&q=80";
      showToast("Preset cover selected!");
    }

    // ARTICLE MODAL & READER
    function openArticleModal(id) {
      playSound('click');
      activeArticle = articles.find(a => a.id === id);
      if(!activeArticle) return;

      const modal = document.getElementById('articleModal');
      const body = document.getElementById('modalBody');
      const likeCount = document.getElementById('modalLikeCount');
      const isSaved = savedIds.includes(activeArticle.id);

      likeCount.innerText = activeArticle.likes;

      document.getElementById('modalBookmarkBtn').innerHTML = isSaved ? 
        `<i class="fa-solid fa-bookmark text-hw-gold"></i>` : 
        `<i class="fa-regular fa-bookmark"></i>`;

      body.innerHTML = `
        <div class="space-y-4">
          <div class="relative rounded-2xl overflow-hidden h-56 border border-hw-border">
            <img src="${activeArticle.image}" class="w-full h-full object-cover" alt="Article image"/>
            <div class="absolute top-3 left-3 bg-hw-gold text-slate-950 font-bold text-[10px] uppercase px-2.5 py-1 rounded-full">
              ${activeArticle.category}
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-1">
              <span>🥊 Wrestler: <strong class="text-white">${activeArticle.wrestler}</strong></span>
              <span>${activeArticle.date}</span>
            </div>
            <h1 class="font-display text-3xl font-black text-white leading-tight uppercase tracking-wide">${activeArticle.title}</h1>
            ${activeArticle.subtitle ? `<p class="text-sm text-hw-gold font-medium mt-1">${activeArticle.subtitle}</p>` : ''}
          </div>

          <div class="border-t border-hw-border pt-3">
            <p id="readerContent" class="${fontSizeLarge ? 'text-lg' : 'text-sm'} text-slate-300 leading-relaxed whitespace-pre-line font-sans">
              ${activeArticle.content}
            </p>
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeArticleModal() {
      playSound('click');
      const modal = document.getElementById('articleModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function toggleFontSize() {
      fontSizeLarge = !fontSizeLarge;
      const content = document.getElementById('readerContent');
      if(content) {
        content.className = `${fontSizeLarge ? 'text-lg' : 'text-sm'} text-slate-300 leading-relaxed whitespace-pre-line font-sans`;
      }
    }

    function likeCurrentArticle() {
      if(!activeArticle) return;
      playSound('click');
      activeArticle.likes += 1;
      document.getElementById('modalLikeCount').innerText = activeArticle.likes;
      localStorage.setItem('hw_articles', JSON.stringify(articles));
      renderArticles();
      showToast("Article Liked! ❤️");
    }

    function toggleBookmarkCurrent() {
      if(!activeArticle) return;
      playSound('click');
      const index = savedIds.indexOf(activeArticle.id);
      if(index > -1) {
        savedIds.splice(index, 1);
        showToast("Removed from Bookmarks");
      } else {
        savedIds.push(activeArticle.id);
        showToast("Saved to Bookmarks! 🔖");
      }
      localStorage.setItem('hw_saved_articles', JSON.stringify(savedIds));
      
      const isSaved = savedIds.includes(activeArticle.id);
      document.getElementById('modalBookmarkBtn').innerHTML = isSaved ? 
        `<i class="fa-solid fa-bookmark text-hw-gold"></i>` : 
        `<i class="fa-regular fa-bookmark"></i>`;
    }

    // SAVED ARTICLES TAB RENDER
    function renderSavedArticles() {
      const container = document.getElementById('savedList');
      const savedArticles = articles.filter(a => savedIds.includes(a.id));

      if(savedArticles.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 bg-hw-card border border-hw-border rounded-2xl">
            <i class="fa-solid fa-bookmark text-3xl text-slate-600 mb-2"></i>
            <p class="text-slate-400 text-sm">No saved articles yet.</p>
            <p class="text-slate-500 text-xs mt-1">Tap the bookmark icon while reading an article to save it here!</p>
          </div>
        `;
        return;
      }

      container.innerHTML = savedArticles.map(art => `
        <div onclick="openArticleModal('${art.id}')" class="bg-hw-card border border-hw-border rounded-2xl p-3.5 flex space-x-3 items-center cursor-pointer">
          <img src="${art.image}" class="w-16 h-16 rounded-xl object-cover flex-shrink-0" />
          <div class="flex-1 min-w-0">
            <span class="text-[10px] text-hw-gold font-bold uppercase">${art.category}</span>
            <h3 class="font-bold text-sm text-white truncate">${art.title}</h3>
            <p class="text-xs text-slate-400">${art.wrestler}</p>
          </div>
        </div>
      `).join('');
    }

    // SIMULATED SHARE
    function simulateShare() {
      playSound('click');
      if (navigator.share) {
        navigator.share({
          title: activeArticle.title,
          text: activeArticle.subtitle,
          url: window.location.href,
        }).catch(() => {});
      } else {
        const dummy = document.createElement('input');
        document.body.appendChild(dummy);
        dummy.value = `${activeArticle.title} - Home Wrestling Network`;
        dummy.select();
        document.execCommand('copy');
        document.body.removeChild(dummy);
        showToast("Article headline copied to clipboard!");
      }
    }

    // PWA & UI HELPERS
    function closePwaBanner() {
      document.getElementById('pwaBanner').style.display = 'none';
    }

    function showPWAInstallPrompt() {
      alert("To install HW Wrestling App on iPhone:\n\n1. Tap the Share button in Safari (bottom center).\n2. Scroll down and tap 'Add to Home Screen'.\n3. Open the HW icon from your iPhone home screen!");
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }
  </script>
</body>
</html>
